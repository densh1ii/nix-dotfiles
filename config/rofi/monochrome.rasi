/**
 * Monochrome rofi theme — minimal, no icons.
 * Save as ~/.config/rofi/monochrome.rasi
 * Reference it from config.rasi with: @theme "monochrome"
 * or launch directly with: rofi -show drun -theme ~/.config/rofi/monochrome.rasi
 */

* {
    bg          : #0d0d0dff;
    bg-alt      : #1a1a1aff;
    fg          : #e0e0e0ff;
    fg-dim      : #808080ff;
    border-col  : #333333ff;
    selected    : #ffffffff;
    selected-fg : #0d0d0dff;

    background-color: transparent;
    text-color: @fg;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    width: 480px;
    location: center;
    anchor: center;
    padding: 0px;
}

mainbox {
    background-color: @bg;
    padding: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg;
    text-color: @fg;
    padding: 12px 16px;
    border: 0px 0px 1px 0px;
    border-color: @border-col;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @fg-dim;
    padding: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "search";
    placeholder-color: @fg-dim;
}

listview {
    background-color: @bg;
    columns: 1;
    lines: 8;
    spacing: 0px;
    padding: 4px 0px;
    fixed-height: false;
    border: 0px;
    scrollbar: false;
    cycle: true;
}

element {
    background-color: transparent;
    text-color: @fg;
    padding: 8px 16px;
    orientation: horizontal;

    /* no icons — plain text rows only */
    children: [ element-text ];
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element selected {
    background-color: @selected;
    text-color: @selected-fg;
}

element-icon {
    size: 0px;
    /* icons disabled */
}

message {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 8px 16px;
    border: 1px 0px 0px 0px;
    border-color: @border-col;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}

error-message {
    background-color: @bg;
    text-color: @fg;
    padding: 16px;
    border: 1px;
    border-color: @border-col;
}
